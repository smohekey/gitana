package gitana:repo@0.11.0;

/// HTTP credential resolution, granted by the host.
///
/// The remote porcelain (`fetch`/`push`/`clone`) authenticates a Smart HTTP `401` the git way, but the
/// component holds no ambient authority to read a netrc, run a credential helper, or prompt — so it
/// *imports* this capability and the **host** answers it, mirroring the native
/// `gitana-remote::CredentialProvider`. The component asks for a credential only when a server answers a
/// `401`, and reports the outcome so the host may persist or erase it. A host that has no credential to
/// offer returns `none` from `fill`, and the `401` stands as the error — there is no error/abort
/// channel, matching the capability's best-effort nature. The credential is either a Basic
/// username/password pair or a pre-encoded scheme (git's `authtype`/`credential` — Bearer/Digest/…), and
/// `fill` returns the multistage-auth signals (`state`/`more`) git's `state` capability drives.
interface credentials {
	/// The context a credential is resolved for — git's credential attributes, carried across the
	/// component boundary from the native `CredentialRequest`.
	record credential-request {
		/// The URL scheme, e.g. `https`.
		protocol: string,
		/// The authority, `host` or `host:port`.
		host: string,
		/// The repository path with no leading slash (e.g. `acme/app.git`), percent-encoded as it
		/// appeared in the URL; absent when the URL has none.
		path: option<string>,
		/// A known username the credential must be for, if any (URL userinfo or `credential.username`) — the
		/// resolution key a provider matches a username-scoped section on; stable across multistage rounds.
		username: option<string>,
		/// The username a previous multistage round learned (git's retained `c->username`), re-presented to
		/// a continuation helper without re-keying helper selection; absent on the first round.
		carried-username: option<string>,
		/// The server's `WWW-Authenticate` challenge values, one per header field, in order — empty
		/// unless this request accompanies a `401` being filled.
		wwwauth: list<string>,
		/// Opaque `state[]` a previous round returned, echoed back to resume a multistage authentication —
		/// empty on the first round.
		state: list<string>,
		/// The `authtype` carried from a previous multistage round (git retains it while clearing the
		/// secret) — absent on the first round or after a Basic round.
		authtype: option<string>,
		/// The `ephemeral` flag carried from a previous multistage round — retained across the round so a
		/// completing helper need not restate it; `false` on the first round.
		ephemeral: bool,
		/// Whether the `authtype` capability was negotiated in a previous round (git retains a capability's
		/// helper-side bit across rounds independently) — `false` on the first round.
		caps-authtype: bool,
		/// Whether the `state` capability was negotiated in a previous round — `false` on the first round.
		caps-state: bool,
	}

	/// A resolved credential, modelled as git's flat `struct credential`: `username`/`password` are the
	/// Basic pair; `authtype`/`credential` (git ≥ 2.42) are a scheme name plus a pre-encoded value forming
	/// `Authorization: <authtype> <credential>` (e.g. `Bearer <token>`). git keeps every populated field
	/// (all ride `store`/`erase`); `ephemeral` marks a short-lived value a helper must not persist.
	record credential {
		username: option<string>,
		password: option<string>,
		authtype: option<string>,
		credential: option<string>,
		ephemeral: bool,
	}

	/// One round of a `fill`: the credential to send, the `state[]` to echo back next round, whether a
	/// further multistage round is expected (git's `continue`), and which capabilities the helper negotiated
	/// this round (`authtype`/`state`) — retained independently across a multistage round so a continuation
	/// helper's capability-gated fields are honoured without re-advertising.
	record filled {
		credential: credential,
		state: list<string>,
		more: bool,
		caps-authtype: bool,
		caps-state: bool,
	}

	/// Resolve a credential for `request`. `none` means none is available (anonymous, none configured,
	/// or the host declined) and the caller proceeds unauthenticated, letting the server's `401` stand.
	fill: func(request: credential-request) -> option<filled>;

	/// Record that `cred` (for `request`) was accepted by the server, so the host may persist it
	/// (git's `credential approve`). Best-effort — it never fails the operation it just authorised.
	approve: func(request: credential-request, cred: credential);

	/// Record that `cred` (for `request`) was rejected by the server, so the host may erase a stale
	/// entry (git's `credential reject`). Best-effort, like `approve`.
	reject: func(request: credential-request, cred: credential);
}

/// SSH transport to a git remote, granted by the host.
///
/// A component cannot spawn a subprocess, so it holds no authority to run `ssh` — yet git's SSH
/// transport *is* a subprocess (git never links an SSH stack, and neither does gitana's native side).
/// So the component *imports* this capability and the **host** owns all ssh policy: which `ssh` binary,
/// which keys, `~/.ssh/config`, the variant and port flag, known-hosts — exactly as `wasi:http` backs
/// the Smart HTTP porcelain. The guest passes only the parsed remote components; the host spawns
/// `git-upload-pack` / `git-receive-pack` on the far side and bridges the subprocess's stdio into a pair
/// of `wasi:io` streams the guest drives the pkt-line negotiation over. The streams are modelled on how
/// `wasi:http` exposes a body: each accessor yields the stream *once* (the guest reads/writes it for the
/// life of the session), and `finish` awaits the subprocess so a nonzero exit surfaces as a transport
/// error rather than a silently truncated pack.
interface ssh-transport {
	use wasi:io/streams@0.2.12.{input-stream, output-stream};

	/// One SSH session to a remote git service — the byte streams of a running `ssh …host git-<service>
	/// '<path>'`, plus its eventual exit. The guest writes its request (`want`/`have`/`done` or a
	/// receive-pack update) to `stdin` and reads the advertisement, ACKs, and packfile from `stdout`, then
	/// `finish`es to reap the subprocess. Dropping the session without `finish` reaps it too.
	resource ssh-session {
		/// The session's response side — the subprocess's stdout (server → client). Yields the stream
		/// once; a second call traps, as the guest holds it for the session's life.
		stdout: func() -> input-stream;

		/// The session's request side — the subprocess's stdin (client → server). Yields the stream once;
		/// the guest closes the request side by dropping it, signalling end-of-request to the server.
		stdin: func() -> output-stream;

		/// Await the subprocess's exit, failing on an unsuccessful status. Stock git reports a nonzero
		/// `ssh` exit as a transport error even when a complete pack was already read, so the guest calls
		/// this once the exchange is done; the payload is a human-readable failure description.
		finish: func() -> result<_, string>;
	}

	/// Open an SSH session running `git-<service>` on the remote — `service` is `git-upload-pack` (fetch/
	/// clone) or `git-receive-pack` (push), `host`/`port`/`user` the connection target, and `path` the
	/// repository path on the remote (single-quoted for the remote shell by the host, as git does). The
	/// host resolves the `ssh` command and variant. Because the component holds no ambient authority, the
	/// host enforces this capability's scope on the arguments before spawning anything: a `service` other
	/// than the two git pack services, or a `-`-leading `host`/`user`/`path`, is refused (git's
	/// CVE-2017-1000117 guard) — a guest cannot use the capability to run an arbitrary process or inject
	/// an `ssh` option. `err` is a human-readable failure (the request was refused, or the ssh command
	/// could not be built or spawned).
	open: func(service: string, host: string, port: option<u16>,
		user: option<string>, path: string) -> result<ssh-session, string>;
}

/// Repository operations over a capability-granted git directory.
///
/// The host passes an **owned** `wasi:filesystem` directory descriptor to
/// `repository.open`; that descriptor is the component's entire filesystem
/// authority — there is no preopen-path convention and no ambient access.
interface porcelain {
	use wasi:filesystem/types@0.2.12.{descriptor};

	/// Engine failures surfaced across the component boundary.
	variant repo-error {
		/// An object, ref, or repository file does not exist.
		not-found(string),
		/// A well-formed revision spec did not resolve to any object.
		unknown-revision(string),
		/// An abbreviated object id matches more than one object.
		ambiguous(string),
		/// A malformed spec, ref name, config, object, or input.
		invalid(string),
		/// A conditional ref update or delete lost the race: the ref was not at
		/// the expected value. The payload is the ref name.
		ref-moved(string),
		/// A working-tree operation would overwrite uncommitted local changes or an
		/// untracked file, and no `force` was given. The payload describes the path.
		conflict(string),
		/// The repository's format or config is not supported.
		unsupported-format(string),
		/// A stored object's bytes hash to a different id than requested.
		corruption(string),
		/// The underlying file store failed.
		backend(string),
	}

	/// The repository's object-hash algorithm, a runtime fact read from its config.
	enum hash-kind {
		sha1,
		sha256,
	}

	/// A git object's type.
	enum object-kind {
		blob,
		tree,
		commit,
		tag,
	}

	/// A raw object: its resolved id, kind, and canonical payload (without the
	/// loose-object header).
	record object-info {
		/// The object id (hex).
		id: string,
		/// The object's kind.
		kind: object-kind,
		/// The canonical object payload.
		payload: list<u8>,
	}

	/// A parsed annotated tag.
	record tag-info {
		/// The tag object's own id (hex).
		id: string,
		/// The tagged object's id (hex).
		target: string,
		/// The tagged object's kind.
		target-kind: object-kind,
		/// The tag name recorded in the object.
		name: string,
		/// The raw tagger line (`Name <email> epoch offset`), if present.
		tagger: option<string>,
		/// The tag message.
		message: string,
	}

	/// A tree-entry mode accepted by `write-tree`. Directories are implied by
	/// entry paths and cannot be written directly; gitlinks are read-only today.
	enum file-mode {
		regular,
		executable,
		symlink,
	}

	/// An input entry for `write-tree`.
	record tree-build-entry {
		/// Repo-relative path (`/` separators).
		path: string,
		/// The entry's mode.
		mode: file-mode,
		/// The blob (or, for `symlink`, target-path blob) id (hex).
		id: string,
	}

	/// One entry of a recursively flattened tree (`ls-tree -r`).
	record tree-entry {
		/// Repo-relative path (`/` separators).
		path: string,
		/// The octal mode string as stored (`100644`, `100755`, `120000`, `160000`).
		mode: string,
		/// The entry's object id (hex).
		id: string,
	}

	/// A direct (non-symbolic) ref and its target id.
	record ref-entry {
		/// The full ref name (e.g. `refs/heads/main`).
		name: string,
		/// The object id the ref points at (hex).
		id: string,
	}

	/// A request to append a reflog entry for a ref move. Present means "log this move"
	/// (still subject to git's `core.logAllRefUpdates` gating); absent means "do not log",
	/// as git's internal/plumbing moves do. The component reads no process env or clock, so
	/// the host supplies the committer line — there is no identity to fall back on.
	record reflog-request {
		/// The reflog committer line (`Name <email> seconds ±hhmm`).
		committer: string,
		/// The reflog message (e.g. `branch: Created from HEAD`), or `""` for none — git
		/// records a line with no message, as `git update-ref` does without `-m`.
		message: string,
	}

	/// The outcome of a `fetch`: the tracking refs it advanced, and any it declined to.
	record fetch-outcome {
		/// Tracking refs advanced — name and new object id (hex).
		updated: list<ref-entry>,
		/// Tracking refs left unchanged because the update was not a fast-forward and the matching
		/// refspec was not forced (no leading `+`); git rejects these too.
		rejected: list<string>,
	}

	/// The branch a successful `push` sent, with its render hint.
	record push-summary {
		/// The branch pushed (e.g. `refs/heads/main`).
		branch: string,
		/// Whether the update was a forced (non-fast-forward) push.
		forced: bool,
	}

	/// The outcome of a `push`.
	variant push-outcome {
		/// `HEAD`'s branch was sent to the remote.
		pushed(push-summary),
		/// A remote branch was deleted (the payload is the full ref name).
		deleted(string),
		/// The remote already had the branch tip; nothing was sent.
		up-to-date,
	}

	/// A symbolic HEAD with its resolved commit.
	record symbolic-head {
		/// The ref HEAD points at (e.g. `refs/heads/main`).
		target: string,
		/// The commit that ref resolves to (hex).
		id: string,
	}

	/// The state of `HEAD`.
	variant head-state {
		/// HEAD points at a ref that does not exist yet (an unborn branch);
		/// the payload is the target ref name.
		unborn(string),
		/// HEAD points at an existing ref.
		symbolic(symbolic-head),
		/// HEAD points directly at a commit (hex id).
		detached(string),
	}

	/// A parsed commit.
	record commit-info {
		/// The commit id (hex).
		id: string,
		/// The tree id (hex).
		tree: string,
		/// Parent commit ids (hex).
		parents: list<string>,
		/// The raw author line (`Name <email> epoch offset`).
		author: string,
		/// The raw committer line.
		committer: string,
		/// The commit message.
		message: string,
	}

	/// What a repack consolidated.
	record repack-report {
		/// Objects written into the new pack(s).
		packed-objects: u64,
		/// New packs written (more than one when the set exceeds the size limit).
		packs-written: u64,
		/// Existing packs left untouched (only for a geometric repack).
		packs-kept: u64,
		/// Old packs deleted (each with its index).
		packs-removed: u64,
		/// Loose objects deleted after being packed.
		loose-removed: u64,
	}

	/// One path's working-tree status, as `git status --porcelain=v1` reports it: an
	/// index code (staged, index-vs-HEAD — the `X` column) and a worktree code
	/// (unstaged, worktree-vs-index — the `Y` column). Each code is a single git
	/// porcelain letter (` `, `A`, `M`, `D`, `R`, …); an unmerged path carries its
	/// conflict letter (`U`/`A`/`D`) in both.
	record status-entry {
		/// Repository-relative path (`/` separators).
		path: string,
		/// The index-vs-HEAD code (`X`), a single-character string.
		index: string,
		/// The worktree-vs-index code (`Y`), a single-character string.
		worktree: string,
	}

	/// A working tree's status: tracked paths whose index or worktree code is not
	/// clean (or that are unmerged), and untracked paths (a fully-untracked directory
	/// collapses to a single `dir/` entry, as git's default mode does). Both lists are
	/// sorted by path.
	record worktree-status {
		/// Tracked paths with a non-clean or conflicted status.
		changed: list<status-entry>,
		/// Untracked paths and collapsed untracked directories.
		untracked: list<string>,
	}

	/// A sparse-checkout set — the arguments to `sparse-set`/`sparse-add` and what `sparse-list`
	/// returns. `cone` selects the mode (`core.sparseCheckoutCone`): when true, `entries` are the
	/// included directories (git's cone model); when false, they are full gitignore-style pattern
	/// lines. The default cone set (root files only) is `sparse-set` with an empty `entries`.
	record sparse-patterns {
		/// Whether this is cone mode (directories) rather than non-cone (patterns).
		cone: bool,
		/// The included directories (cone) or pattern lines (non-cone).
		entries: list<string>,
	}

	/// The outcome of applying (or reapplying) sparse patterns. Both lists are paths the caller
	/// resolves before reapplying; no work is lost in either case. git prints these as "left despite
	/// sparse patterns" and "already present ... not updated despite sparse patterns" respectively.
	record sparse-outcome {
		/// Excluded-but-modified paths left in the working tree (skip-worktree not set).
		left-dirty: list<string>,
		/// Included paths not materialised because an untracked file occupies an ancestor slot: that
		/// file is preserved and the path's skip-worktree bit is cleared, but nothing is written.
		not-updated: list<string>,
	}

	resource repository {
		/// Open the repository whose git directory is `git-dir` — an owned
		/// directory descriptor granted by the host. Reads `config` through the
		/// descriptor to detect the object format (absent
		/// `extensions.objectformat` means sha1, as in git). For an ordinary
		/// repository `git-dir` is also the common directory; use
		/// `open-worktree` for a linked worktree whose two directories differ.
		/// A repository opened this way has no working tree, so the working-tree
		/// operations (`status`/`add`/`checkout`/`commit`) fail on it — use
		/// `open-worktree` to grant a `work-dir`.
		open: static func(git-dir: descriptor) -> result<repository, repo-error>;

		/// Open a repository *together with its working tree*, over three owned
		/// directory descriptors:
		///
		/// - `git-dir` — the per-worktree state (`HEAD`, `index`, in-progress
		///   merge/rebase/cherry-pick);
		/// - `common-dir` — the shared objects, refs, `packed-refs`, and `config`;
		/// - `work-dir` — the checked-out working tree.
		///
		/// For a *linked worktree* (created by `git worktree add`) `git-dir` and
		/// `common-dir` differ and each path is routed to the directory that owns it;
		/// for an ordinary repository pass the same descriptor as both. The object
		/// format is detected from `common-dir`'s `config`. Only a repository opened
		/// this way can run the working-tree operations (`status`, `add`, `checkout`,
		/// `commit`); one opened via `open`/`init` has no working tree and those
		/// operations fail.
		open-worktree: static func(git-dir: descriptor, common-dir: descriptor, work-dir: descriptor) -> result<repository, repo-error>;

		/// Initialize a fresh repository in `git-dir` with the given object
		/// format, then open it: git's empty directory skeleton, a `config`,
		/// and a symbolic `HEAD → refs/heads/main`. Idempotent — existing files
		/// are left untouched; a directory already holding a repository of a
		/// *different* format fails with `unsupported-format`.
		init: static func(git-dir: descriptor, kind: hash-kind) -> result<repository, repo-error>;

		/// Clone the Smart HTTP remote at `url` into a freshly-granted, empty checkout
		/// over the host-granted `wasi:http` capability. `git-dir` receives the git
		/// directory (skeleton, `config`, refs, objects) and `work-dir` the checked-out
		/// working tree; both must be empty owned directory descriptors. The local
		/// object format is whatever the remote advertises. Consumes both descriptors —
		/// it does not return a repository resource (a clone populates directories rather
		/// than opening one); reopen the result with `open-worktree` to operate on it.
		clone: static func(git-dir: descriptor, work-dir: descriptor, url: string) -> result<_, repo-error>;

		/// The object-hash algorithm detected at `open`.
		hash-kind: func() -> hash-kind;

		/// The raw text of the repository's `config` file.
		read-config: func() -> result<string, repo-error>;

		/// Resolve `spec` and read the raw object it names. Every `spec` in this
		/// interface accepts the full rev-parse syntax (`HEAD`, ref names, hex or
		/// abbreviated ids, `~`/`^`/`^{type}` forms, `<rev>:<path>`).
		read-object: func(spec: string) -> result<object-info, repo-error>;

		/// Resolve `spec` and read it as a blob.
		read-blob: func(spec: string) -> result<list<u8>, repo-error>;

		/// Resolve `spec` and read it as a commit.
		read-commit: func(spec: string) -> result<commit-info, repo-error>;

		/// Resolve `spec` and read it as an annotated tag.
		read-tag: func(spec: string) -> result<tag-info, repo-error>;

		/// Recursively list the tree `spec` peels to (a commit, tag, or tree).
		ls-tree: func(spec: string) -> result<list<tree-entry>, repo-error>;

		/// Resolve `spec` to an object id (hex).
		rev-parse: func(spec: string) -> result<string, repo-error>;

		/// The commits reachable from `tips` (each a spec), committer-date newest
		/// first, truncated to `max-count` when given. Returns ids; compose with
		/// `read-commit` for a log.
		rev-list: func(tips: list<string>, max-count: option<u32>) -> result<list<string>, repo-error>;

		/// The best common ancestor(s) — merge bases — of `commits`; an empty
		/// list when they share none (data, not an error).
		merge-base: func(commits: list<string>) -> result<list<string>, repo-error>;

		/// Whether `ancestor` is reachable from `descendant`.
		is-ancestor: func(ancestor: string, descendant: string) -> result<bool, repo-error>;

		/// Direct refs under `prefix` (e.g. `refs/heads/`), with packed-refs
		/// merged in (a loose file wins), sorted by name.
		list-refs: func(prefix: string) -> result<list<ref-entry>, repo-error>;

		/// The state of `HEAD`.
		head: func() -> result<head-state, repo-error>;

		/// Resolve the exact ref `name` — loose, then packed-refs. `none` when
		/// the ref does not exist.
		resolve-ref: func(name: string) -> result<option<string>, repo-error>;

		/// Compare-and-set `name` to `new` (a spec). `expected` is the ref's
		/// current value as a full hex id, or absent to require that the ref
		/// does not exist yet (create). A mismatch fails with `ref-moved`.
		/// `reflog` requests a reflog entry for the move (subject to
		/// `core.logAllRefUpdates` gating); absent writes none.
		update-ref: func(name: string, new: string, expected: option<string>, reflog: option<reflog-request>) -> result<_, repo-error>;

		/// Compare-and-delete `name`; `expected` is its current full hex id.
		/// Also removes the name from `packed-refs`.
		delete-ref: func(name: string, expected: string) -> result<_, repo-error>;

		/// The target of the symbolic ref `name`, or `none` if it is absent or
		/// not symbolic.
		read-symbolic-ref: func(name: string) -> result<option<string>, repo-error>;

		/// Point the symbolic ref `name` at `target` (name `HEAD` moves HEAD).
		/// `reflog` requests a reflog entry for the retarget (subject to
		/// `core.logAllRefUpdates` gating); absent writes none.
		set-symbolic-ref: func(name: string, target: string, reflog: option<reflog-request>) -> result<_, repo-error>;

		/// Write `data` as a loose blob object; returns its id (hex). Writing a
		/// blob that already exists is a no-op returning the same id.
		write-blob: func(data: list<u8>) -> result<string, repo-error>;

		/// Build the nested tree objects for `entries` and return the root tree
		/// id (hex). Entry ids are full hex ids, not specs.
		write-tree: func(entries: list<tree-build-entry>) -> result<string, repo-error>;

		/// Write a commit object (no ref update), returning its id (hex).
		/// `tree` and each parent are specs; `author`/`committer` are raw git
		/// identity lines (`Name <email> epoch offset`).
		create-commit: func(tree: string, parents: list<string>, author: string,
			committer: string, message: string) -> result<string, repo-error>;

		/// Consolidate loose objects and packs into packs bounded by the repo's
		/// `pack.packSizeLimit`. `geometric` keeps large existing packs (git's
		/// incremental strategy, factor 2). `none` when there was nothing to do.
		repack: func(geometric: bool) -> result<option<repack-report>, repo-error>;

		// -- Remote operations (over the host-granted `wasi:http` capability).

		/// Fetch from the Smart HTTP remote at `url` (a base URL such as
		/// `https://host/owner/repo.git`) over the host-granted `wasi:http` capability:
		/// download the objects this repository lacks and update the tracking refs its
		/// `remote.origin.fetch` refspecs map the advertised refs to (falling back to the
		/// default `+refs/heads/*:refs/remotes/origin/*` when none are configured). The
		/// working tree is not touched, so this works on a repository opened via `open` or
		/// `open-worktree`. The remote's advertised object-format must match this
		/// repository's, else `invalid`.
		fetch: func(url: string) -> result<fetch-outcome, repo-error>;

		/// Push `HEAD`'s branch to the Smart HTTP remote at `url` over the host-granted
		/// `wasi:http` capability, or — with `delete` set to a branch name — remove that
		/// branch on the remote. `force` permits a non-fast-forward update. Reads refs and
		/// packs objects, so this works on a repository opened via `open` or `open-worktree`.
		/// The remote's advertised object-format must match this repository's, else `invalid`.
		/// Signed pushes are not yet supported (signing is deferred to the trust work).
		push: func(url: string, force: bool, delete: option<string>) -> result<push-outcome, repo-error>;

		// -- Working-tree operations (require a repository opened via `open-worktree`).

		/// The three-way working-tree status: the `HEAD` tree vs the index (staged)
		/// and the index vs the working tree (unstaged), plus untracked paths —
		/// `git status --porcelain=v1` as structured data.
		status: func() -> result<worktree-status, repo-error>;

		/// Stage `pathspecs` into the index. Each is a working-tree path (`/`
		/// separators) interpreted relative to `prefix` (a `/`-joined work-tree
		/// subdirectory, empty at the root); `.` or a directory is walked (applying
		/// `.gitignore`) and its files staged, and a path that no longer exists is
		/// staged as a deletion — `git add`.
		add: func(pathspecs: list<string>, prefix: string) -> result<_, repo-error>;

		/// Materialise the tree that `tree-ish` peels to (a commit, tag, or tree
		/// spec) into the working tree and index. Does not move `HEAD`. Without
		/// `force`, fails with `conflict` rather than overwrite uncommitted local
		/// changes or an untracked file.
		checkout: func(tree-ish: string, force: bool) -> result<_, repo-error>;

		/// Record a commit from the staged index on the current branch, returning
		/// the new commit id (hex). Refuses an unmerged or empty index. `author`
		/// and `committer` are raw git identity lines (`Name <email> epoch offset`)
		/// — the component reads no process env or clock, so the host supplies them.
		/// Requires a symbolic `HEAD` (committing on a detached `HEAD` is not
		/// supported).
		commit: func(message: string, author: string, committer: string) -> result<string, repo-error>;

		// -- Sparse-checkout (require a repository opened via `open-worktree`).

		/// Replace the sparse-checkout set with `patterns` and apply it (git's `sparse-checkout set`, and
		/// `init` when `patterns` is empty). `cone` selects the mode: cone directories, or non-cone
		/// gitignore-style pattern lines. Persists git's config (`extensions.worktreeConfig` in the common
		/// config; `core.sparseCheckout`/`core.sparseCheckoutCone` per-worktree), writes
		/// `info/sparse-checkout`, and materialises/omits working-tree files to match — returning any
		/// excluded-but-modified paths left behind.
		sparse-set: func(patterns: list<string>, cone: bool) -> result<sparse-outcome, repo-error>;

		/// Extend the current sparse-checkout set with `patterns`, keeping the configured mode, then apply
		/// it (git's `sparse-checkout add`). Fails with `invalid` if sparse-checkout is not enabled.
		sparse-add: func(patterns: list<string>) -> result<sparse-outcome, repo-error>;

		/// The current sparse-checkout set — the included directories (cone) or pattern lines (non-cone) —
		/// or `none` when sparse-checkout is not enabled (git's `sparse-checkout list`).
		sparse-list: func() -> result<option<sparse-patterns>, repo-error>;

		/// Disable sparse-checkout, materialising the whole working tree and clearing the skip-worktree
		/// bits (git's `sparse-checkout disable`). The config booleans are set false; the pattern file is
		/// left in place, as git leaves it. `not-updated` reports any path whose materialisation an
		/// untracked file blocked (`left-dirty` is always empty here — disable removes no content).
		sparse-disable: func() -> result<sparse-outcome, repo-error>;

		/// Re-apply the current sparse-checkout patterns to the working tree (git's `sparse-checkout
		/// reapply`) — omitting newly-excluded clean files, materialising newly-included ones. A no-op
		/// when sparse-checkout is disabled.
		sparse-reapply: func() -> result<sparse-outcome, repo-error>;
	}
}

world repo {
	import wasi:filesystem/types@0.2.12;
	// The network capability for the remote porcelain (fetch/clone/push): the host grants a
	// `wasi:http` outgoing handler, the component's only means of reaching a Smart HTTP remote.
	import wasi:http/outgoing-handler@0.2.12;
	// The credential capability for authenticating a Smart HTTP `401`: the host answers `fill`/`approve`/
	// `reject`, so the component reaches for no ambient netrc/helper/prompt.
	import credentials;
	// The SSH transport capability for the remote porcelain over `ssh://` / scp-like remotes: the host
	// spawns `ssh` and bridges its stdio into `wasi:io` streams, the component's only means of reaching an
	// SSH git remote (it cannot spawn a subprocess itself).
	import ssh-transport;

	export porcelain;
}
